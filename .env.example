# PostgreSQL connection for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/msm_accounting?schema=public"

# JWT signing secret (change in production)
JWT_SECRET="replace-with-a-long-random-string-in-production"

# Google OAuth client ID (same value used by frontend and backend)
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Frontend origin for CORS during local development
FRONTEND_ORIGIN="http://127.0.0.1:5173"

# Optional: set for local debugging
NODE_ENV="development"

# Multi-document workspace (Accurate-style tabs). 1 = on, anything else = off.
# When on, AR sales-orders/invoices open as keep-alive tabs and other modules
# render in a single shared tab. Off by default.

# Force the Secure flag on the session cookie even when NODE_ENV != production.
# Set to "true" for any HTTPS deployment (e.g. staging) so the auth cookie is
# never sent over plain HTTP. In production it is already Secure regardless.
COOKIE_SECURE=""

# Optional: where database backups are written on the server.
# Defaults to <project>/data/backups. Cloud/external destinations (external
# drive, Google Drive / OneDrive synced folders) are configured in the app's
# Settings → Backup & Restore screen.
BACKUP_DIR=""

# REQUIRED to enable backup endpoints. Comma-separated list of platform-operator
# emails allowed to run/download/restore/configure full-database backups. These
# dumps contain EVERY tenant's data, so they are gated to platform admins here
# (not an org-level permission a tenant admin could grant themselves). If unset,
# all backup endpoints are denied (fail-closed).
PLATFORM_ADMIN_EMAILS=""
