# Copy this to deploy/.env and fill in real values. docker compose reads it
# automatically. Do NOT commit deploy/.env — it holds secrets.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
# Use a strong password. This is the DB superuser for the Postgres container.
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=msm_accounting

# --- App secrets ------------------------------------------------------------
# Long random string used to sign session JWTs. Generate one, e.g.:
#   PowerShell:  [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=change-me-to-a-long-random-string

# Platform-operator email(s) allowed to run/download/restore full-DB backups.
# Comma-separated. Leave blank to keep all backup endpoints disabled (fail-closed).
PLATFORM_ADMIN_EMAILS=haelykk@gmail.com

# --- Networking / access ----------------------------------------------------
# The hostname staff type in the browser. Must resolve to this server's LAN IP
# on each client (hosts file or local DNS — see README). Avoid the .local suffix
# (mDNS conflicts on Windows); .msm / .lan / .internal are safe.
SITE_HOST=accounting.msm

# --- Backups ----------------------------------------------------------------
# Host folder where DB backups are written. Use an absolute Windows path to
# keep them off the system drive, e.g. D:/msm-backups
BACKUP_DIR_HOST=./backups

# --- Google sign-in (optional) ----------------------------------------------
# Leave blank if you only use email/password login.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
