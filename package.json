{
  "name": "msm-accounting-software",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "postinstall": "npm run prisma:generate",
    "prebackend:dev": "npm run prisma:generate",
    "backend:dev": "next dev",
    "prebackend:build": "npm run prisma:generate",
    "backend:build": "next build",
    "prebackend:start": "npm run prisma:generate",
    "backend:start": "next start",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-accounts": "tsx scripts/backfill-standard-accounts.ts",
    "db:indexes": "node --env-file-if-exists=.env scripts/apply-db-indexes.mjs",
    "db:migration": "node --env-file-if-exists=.env scripts/new-migration.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run lib/__tests__/middleware-security.test.ts lib/__tests__/temporary-password.test.ts lib/approval/__tests__/authorization.test.ts src/app/api/v1/__tests__/auth-account-status.test.ts",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:int:setup": "tsx scripts/test-db-setup.mjs",
    "bench:capacity": "tsx scripts/benchmark-capacity.ts",
    "test:e2e:setup": "node scripts/e2e-db-setup.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:accounting": "playwright test e2e/accounting-journeys.spec.ts e2e/accounting-edge-cases.spec.ts e2e/returns-to-ledger.spec.ts --project=chromium",
    "test:e2e:all": "playwright test --project=chromium --project=pos",
    "typecheck:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "test:e2e:pos": "playwright test --project=pos",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/file-saver": "^2.0.7",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "19.2.14",
    "@types/xlsx": "^0.0.35",
    "@vitejs/plugin-react": "^5.1.3",
    "prisma": "6.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "esbuild": "^0.28.2",
    "node-cron": { "uuid": "^11.1.1" }
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "@react-oauth/google": "^0.13.4",
    "@tailwindcss/vite": "^4.2.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-virtual": "^3.13.19",
    "bcryptjs": "^3.0.3",
    "dexie": "^4.4.4",
    "file-saver": "^2.0.5",
    "google-auth-library": "^10.6.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.1.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.563.0",
    "next": "^15.5.27",
    "node-cron": "^3.0.3",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.4",
    "react-to-print": "^3.3.0",
    "resend": "^6.10.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.0",
    "tesseract.js": "^5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1",
    "zustand": "^5.0.11"
  }
}
