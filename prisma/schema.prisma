model EmployeeCompensationItem {
  id           String            @id @default(cuid())
  employeeId   String
  type         CompensationType
  name         String
  amount       Decimal           @default(0) @db.Decimal(18, 2)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

