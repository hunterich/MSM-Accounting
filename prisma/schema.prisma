  @@unique([purchaseReturnId, lineNo])
  @@index([itemId])
}

model DebitNote {
  id                 String            @id @default(cuid())
  organizationId     String
  number             String
  purchaseReturnId   String?
  vendorId           String
  sourceBillId       String?
  date               DateTime
  settlementType     DebitSettlementType @default(APPLY_TO_BILL)
  settlementRef      String?
