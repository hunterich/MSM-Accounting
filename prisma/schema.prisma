  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor                Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  item                  Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  account               Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([organizationId, vendorId, normalizedSupplierLabel])
  @@index([organizationId, normalizedSupplierLabel])
}

model APPayment {
  id                String        @id @default(cuid())
  organizationId    String
  number            String
  vendorId          String
  date              DateTime
  method            PaymentMethod @default(BANK_TRANSFER)
  bankAccountId     String?
  cashAccountId     String?
  apAccountId       String?
  discountAccountId String?
  penaltyAccountId  String?
  reference         String?
  status            PaymentStatus @default(DRAFT)
  totalAmount       Decimal       @default(0) @db.Decimal(18, 2)
  /// Idempotency token: set once the DR/CR pair is posted to the GL.
  journalEntryId String?  @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor            Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
