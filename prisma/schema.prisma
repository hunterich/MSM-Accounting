model DeliveryNote {
  id             String             @id @default(cuid())
  organizationId String
  number         String
  salesOrderId   String
  date           DateTime           @db.Date
  status         DeliveryNoteStatus @default(DRAFT)
  notes          String?
  warehouseId    String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id])
  salesOrder     SalesOrder         @relation(fields: [salesOrderId], references: [id])
  warehouse      Warehouse?         @relation(fields: [warehouseId], references: [id])
  createdBy      User?              @relation(fields: [createdById], references: [id])
  lines          DeliveryNoteLine[]
  @@unique([organizationId, number])
  @@index([organizationId, salesOrderId])
}

model DeliveryNoteLine {
  id               String       @id @default(cuid())
  deliveryNoteId   String
  salesOrderItemId String
  itemId           String
  qtyOrdered       Decimal      @db.Decimal(15, 4)
  qtyDelivered     Decimal      @db.Decimal(15, 4)
  deliveryNote     DeliveryNote   @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  item             Item           @relation(fields: [itemId], references: [id])
}

model InventoryLot {
  id             String                @id @default(cuid())
  organizationId String
  itemId         String
  warehouseId    String?
  documentType   InventoryDocumentType
  documentId     String
  date           DateTime
  qtyIn          Decimal               @default(0) @db.Decimal(15, 4)
  qtyOut         Decimal               @default(0) @db.Decimal(15, 4)
  qtyBalance     Decimal               @db.Decimal(15, 4)
  unitCost       Decimal               @db.Decimal(15, 6)
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id])
  item           Item                  @relation(fields: [itemId], references: [id])
  warehouse      Warehouse?            @relation(fields: [warehouseId], references: [id])
  @@index([organizationId, itemId, date])
  @@index([itemId, warehouseId, date])
}

model BankStatement {
  id             String              @id @default(cuid())
  organizationId String
  bankAccountId  String
  filename       String
  importedAt     DateTime            @default(now())
  fromDate       DateTime?
  toDate         DateTime?
  organization   Organization        @relation(fields: [organizationId], references: [id])
  bankAccount    BankAccount         @relation(fields: [bankAccountId], references: [id])
  lines          BankStatementLine[]
  @@index([organizationId, bankAccountId])
}

model BankStatementLine {
  id          String      @id @default(cuid())
  statementId String
  date        DateTime
  description String
  amount      Decimal     @db.Decimal(15, 2)
  balance     Decimal?    @db.Decimal(15, 2)
  matchStatus MatchStatus @default(UNMATCHED)
  matchedTxId String?
  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  @@index([statementId])
}

// ─── Recurring Invoices ───────────────────────────────────────────────────────

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  ENDED
}

model RecurringInvoice {
  id             String             @id @default(cuid())
  organizationId String
  customerId     String
  title          String
  frequency      RecurringFrequency
  dayOfMonth     Int?
  startDate      DateTime           @db.Date
  endDate        DateTime?          @db.Date
  nextRunDate    DateTime           @db.Date
  status         RecurringStatus    @default(ACTIVE)
  autoPost       Boolean            @default(false)
  notes          String?
  taxRate        Decimal            @default(0) @db.Decimal(5, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines             RecurringInvoiceLine[]
  generatedInvoices SalesInvoice[]

  @@index([organizationId, nextRunDate, status])
}

model RecurringInvoiceLine {
  id          String           @id @default(cuid())
  recurringId String
  lineNo      Int
  itemId      String?
  accountId   String?
  description String
  quantity    Decimal          @db.Decimal(15, 4)
  unit        String?
  price       Decimal          @db.Decimal(15, 2)
  discountPct Decimal          @default(0) @db.Decimal(5, 2)
  taxable     Boolean          @default(true)

  recurring   RecurringInvoice @relation(fields: [recurringId], references: [id], onDelete: Cascade)

  @@unique([recurringId, lineNo])
}

model RecurringBill {
  id             String             @id @default(cuid())
  organizationId String
  vendorId       String
  title          String
  frequency      RecurringFrequency
  dayOfMonth     Int?
  startDate      DateTime           @db.Date
  endDate        DateTime?          @db.Date
  nextRunDate    DateTime           @db.Date
  status         RecurringStatus    @default(ACTIVE)
  autoPost       Boolean            @default(false)
  notes          String?
  taxRate        Decimal            @default(0) @db.Decimal(5, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines          RecurringBillLine[]
  generatedBills Bill[]

  @@index([organizationId, nextRunDate, status])
}

model RecurringBillLine {
  id          String        @id @default(cuid())
  recurringId String
  lineNo      Int
  itemId      String?
  accountId   String?
  description String
  quantity    Decimal       @db.Decimal(15, 4)
  unit        String?
  price       Decimal       @db.Decimal(15, 2)
  discountPct Decimal       @default(0) @db.Decimal(5, 2)
  taxable     Boolean       @default(true)

  recurring   RecurringBill @relation(fields: [recurringId], references: [id], onDelete: Cascade)

  @@unique([recurringId, lineNo])
}

// ─── Approval Workflow ────────────────────────────────────────────────────────

enum ApprovalDocumentType {
  INVOICE
  PURCHASE_ORDER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id             String               @id @default(cuid())
  organizationId String
  documentType   ApprovalDocumentType
  documentId     String
  requestedById  String
  requestedAt    DateTime             @default(now())
  status         ApprovalStatus       @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  note           String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User         @relation("ApprovalReqBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy     User?        @relation("ApprovalRevBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, documentType, documentId])
}
// ─── Asset Management ───────────────────────────────────────────────────────

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
  DOUBLE_DECLINING
}

enum AssetStatus {
  DRAFT
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
  WRITTEN_OFF
}

model AssetCategory {
  id                   String             @id @default(cuid())
  organizationId       String
  name                 String
  depreciationMethod   DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeMonths     Int                @default(60)
  salvagePercent       Decimal            @default(0) @db.Decimal(5, 2)
  assetAccountId       String?
  depExpenseAccountId  String?
  accumDepAccountId    String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets               Asset[]

  @@unique([organizationId, name])
}

model Asset {
  id                      String             @id @default(cuid())
  organizationId          String
  assetNo                 String
  name                    String
  description             String?
  categoryId              String
  acquisitionDate         DateTime
  acquisitionCost         Decimal            @db.Decimal(18, 2)
  depreciationMethod      DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeMonths        Int                @default(60)
  salvageValue            Decimal            @default(0) @db.Decimal(18, 2)
  accumulatedDepreciation Decimal            @default(0) @db.Decimal(18, 2)
  bookValue               Decimal            @db.Decimal(18, 2)
  status                  AssetStatus        @default(DRAFT)
  location                String?
  custodian               String?
  department              String?
  serialNumber            String?
  vendor                  String?
  lastDepreciationDate    DateTime?
  disposalDate            DateTime?
  disposalAmount          Decimal?           @db.Decimal(18, 2)
  disposalMethod          String?
  disposalNotes           String?
  disposalGainLoss        Decimal?           @db.Decimal(18, 2)
  deletedAt               DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  organization            Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category                AssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  depreciationEntries     AssetDepreciation[]

  @@unique([organizationId, assetNo])
  @@index([organizationId, status])
}

model AssetDepreciation {
  id                String       @id @default(cuid())
  organizationId    String
  assetId           String
  date              DateTime
  month             Int
  year              Int
  amount            Decimal      @db.Decimal(18, 2)
  accumulatedTotal  Decimal      @db.Decimal(18, 2)
  bookValue         Decimal      @db.Decimal(18, 2)
  journalEntryId    String?
  createdAt         DateTime     @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset             Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, month, year])
  @@index([organizationId, year, month])
}

